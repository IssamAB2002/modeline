modeline.online {
    encode gzip

    # Django API
    @api path /api/*
    handle @api {
        reverse_proxy backend:8000
    }

    @admin path /admin/*
    handle @admin {
        reverse_proxy backend:8000
    }

    # Product pages → Django SSR (OG meta tags + embedded JSON hydration)
    @product path /product/*
    handle @product {
        reverse_proxy backend:8000
    }

    # Django-collected static files (admin, DRF) — WhiteNoise-hashed filenames,
    # safe to cache for a year and mark immutable.
    @static path /static/*
    handle @static {
        root * /srv/static
        uri strip_prefix /static
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Uploaded media files
    @media path /media/*
    handle @media {
        root * /srv/media
        uri strip_prefix /media
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Static frontend — css/js/assets aren't content-hashed, so this can't be
    # marked immutable — must-revalidate keeps a stale deploy from sticking
    # past the cache window while still giving 30 days of fast repeat loads.
    @frontend_assets path /css/* /js/* /assets/*
    handle @frontend_assets {
        root * /srv/static-frontend
        header Cache-Control "public, max-age=2592000, must-revalidate"
        file_server
    }

    # Static frontend — all remaining routes served as an MPA
    handle {
        root * /srv/static-frontend
        try_files {path} {path}.html /index.html
        file_server
    }
}

www.modeline.online {
    redir https://modeline.online{uri} permanent
}
